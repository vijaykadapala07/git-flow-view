# Copy to .env and fill in. .env is git-ignored; never commit it.

# ---------------------------------------------------------------- AI
# Recommended: use your own Claude Code login through the `claude` CLI.
# No API key is needed; run `claude` once in a terminal to sign in first.
LOCAL_CLAUDE_CLI=1
# Optional model for the CLI, e.g. claude-sonnet-5. Empty = the CLI default.
CLAUDE_CLI_MODEL=
# Only read when LOCAL_CLAUDE_CLI is not 1. Set a real OpenAI key there to use
# OpenAI instead; with the CLI any placeholder is fine.
OPENAI_API_KEY=not-used-with-claude-cli

# ---------------------------------------------------------------- Repos
# Private repos are read from git clones on your machine, never the GitHub API.
# Option 1: clones you already have, comma-separated owner/repo=/absolute/path
LOCAL_REPOS=
# Option 2: clone any repo you can access on first open, with your `gh` login
# (run `gh auth login` first). Clones go to ~/.gitflowview/repos, bare, and no
# token is written to them.
GH_AUTO_CLONE=1
# Optional: let the search box accept a bare repo name for this owner.
NEXT_PUBLIC_DEFAULT_OWNER=
# Optional: GitHub token for public repos that have no local clone (higher
# rate limit). Not needed for private repos with the options above.
GITHUB_PAT=

# ---------------------------------------------------------------- Storage
# Local stand-ins started by `docker compose -f docker-compose.local.yml up -d`.
# These values match that file; change them only if you change it.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-token
R2_ENDPOINT=http://localhost:9090
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_PUBLIC_BUCKET=gitflowview-public
R2_PRIVATE_BUCKET=gitflowview-private
# Any long random string, e.g. from `openssl rand -hex 32`.
CACHE_KEY_SECRET=

# ---------------------------------------------------------------- Limits
# A local tool needs no per-network generation limits.
GENERATION_RATE_LIMIT_MAX=100000
GENERATION_INFRASTRUCTURE_RATE_LIMIT_MAX=100000
